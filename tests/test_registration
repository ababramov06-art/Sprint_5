        driver.find_element(*Locators.BUTTON_REG).click() # На форме входа нажимаем кнопку "Зарегистрироваться".

        time.sleep(30)
        assert 1 == 1

    def test_unsuccessful_registration(self, driver):
        assert 1 == 1
    